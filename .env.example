# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For production, use service role key (keep secret!)
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# Demo Mode: Set to true to use synthetic fallback data when Supabase is unavailable
DEMO_MODE=true
